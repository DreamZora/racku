{
  "name": "racku",
  "version": "0.7.0",
  "description": "A Bun framework of hot-swappable devices mounted in a 42U-style rack",
  "keywords": [
    "bun",
    "framework",
    "hot-swap",
    "hot-reload",
    "workers",
    "supervision",
    "watchdog",
    "rack"
  ],
  "homepage": "https://github.com/DreamZora/racku#readme",
  "bugs": {
    "url": "https://github.com/DreamZora/racku/issues"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DreamZora/racku.git"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "exports": {
    ".": "./src/index.ts",
    "./std": "./src/std/index.ts",
    "./bench": "./src/bench.ts"
  },
  "bin": {
    "rack": "./src/cli.ts"
  },
  "files": [
    "src",
    "docs",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:decisions": "bun scripts/check-decisions.ts",
    "check:docs": "bun scripts/check-docs.ts",
    "render:images": "bun scripts/render-images.ts",
    "check": "bun run typecheck && bun run lint && bun run check:decisions && bun run check:docs && bun test"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/bun": "1.4.4",
    "@valibot/to-json-schema": "1.8.0",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
